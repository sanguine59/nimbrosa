{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "scripts/**/*"],
  // src/web is a separate Vite app with its own tsconfig, JSX settings and
  // bundler resolution. Compiling it with the Node-targeted config here fails.
  "exclude": ["node_modules", "dist", "src/web"]
}
