# Required: no defaults for any of these

# OpenRouter API key (used for both the LLM structuring call and embeddings).
OPENROUTER_API_KEY=


# The name of the embedding model you will be calling
OPENROUTER_EMBEDDING_MODEL=

# Output dimension of the chosen embedding model (sets the pgvector column size at migration time).
# make sure it matches the dimension output based on the embedding model of your choice since each model has different dimension
EMBEDDING_DIMENSIONS=

# LLM used for the structuring step
OPENROUTER_MODEL=

# Cosine-similarity cutoff between "distinct" (Case A) and "match" (Case B),
# strictly between 0 and 1. Needs empirical tuning on real data - no default.
# this should be adjusted to avoid false positive / false negative result
SIMILARITY_THRESHOLD=

# Your webhook secret key
WEBHOOK_SECRET_KEY=

# Postgres credentials. docker-compose uses these to initialise the database
# and to build DATABASE_URL for the backend services, so compose refuses to
# start if they are unset. Use real values, not the postgres/postgres default.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=nimbrosa

# pgAdmin login. Only needed if you start the optional dev profile:
#   docker compose --profile dev up pgadmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Optional

# Defaults to the docker-compose local instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nimbrosa

# Defaults to https://openrouter.ai/api/v1
#OPENROUTER_BASE_URL=

# Tolerance before webhook signature is considered invalid
WEBHOOK_TIMESTAMP_TOLERANCE=

# Webhook encoding algorithm, defaults to sha256
WEBHOOK_ENCODE_ALG=

# Webhook digestion method, defaults to base64
WEBHOOK_DIGEST_METHOD=

# The webhook server port, defaults to 3000
WEBHOOK_SERVER_PORT=

# The data API port, defaults to 3001
API_PORT=

# Origin allowed to call the data API, defaults to http://localhost:5173
# (the Vite dev server). Set this to your real frontend origin when deploying.
CORS_ORIGIN=
