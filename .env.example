# Copy to .env and fill in. npm run serve / start / migrate load it
# automatically via node --env-file-if-exists.
#
# For CI: paste this entire file, filled in, into a single Gitea secret named
# APP_ENV. The workflow writes it back out to .env, so there is one secret to
# manage instead of one per variable.

# Required: no defaults for any of these

# OpenRouter API key (used for both the LLM structuring call and embeddings).
OPENROUTER_API_KEY=


# The name of the embedding model you will be calling
OPENROUTER_EMBEDDING_MODEL=

# Output dimension of the chosen embedding model (sets the pgvector column size at migration time).
# make sure it matches the dimension output based on the embedding model of your choice since each model has different dimension
EMBEDDING_DIMENSIONS=

# Optional: run embeddings against a self-hosted server instead of OpenRouter,
# while the structuring LLM stays on OPENROUTER_BASE_URL. Point this at an
# OpenAI-compatible server — the client POSTs {baseUrl}/embeddings.
# For the text-embeddings-inference service in docker-compose.server.yml:
#   EMBEDDING_BASE_URL=http://localhost:8087/v1
#   OPENROUTER_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
#   EMBEDDING_DIMENSIONS=1024
# Note: src/http.ts only permits http:// for localhost, 127.0.0.1 and ::1.
# A container hostname or LAN address needs https:// or a code change.
#EMBEDDING_BASE_URL=

# Optional: auth for that server. Defaults to OPENROUTER_API_KEY, then to a
# placeholder, since a self-hosted embedding server usually has no auth.
#EMBEDDING_API_KEY=

# LLM used for the structuring step
OPENROUTER_MODEL=

# Cosine-similarity cutoff between "distinct" (Case A) and "match" (Case B),
# strictly between 0 and 1. Needs empirical tuning on real data - no default.
# this should be adjusted to avoid false positive / false negative result
SIMILARITY_THRESHOLD=

# Your webhook secret key
WEBHOOK_SECRET_KEY=

# Optional

# Defaults to the docker-compose local instance.
#
# On the server the app runs as a container, so this must name the compose
# service instead of localhost — "localhost" in there is the app container:
#   DATABASE_URL=postgres://<user>:<pass>@db:5432/nimbrosa
# Port 5432, not the 5433 published on the host. The deploy job rejects an
# APP_ENV whose DATABASE_URL still says localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nimbrosa

# Defaults to https://openrouter.ai/api/v1
#OPENROUTER_BASE_URL=

# Tolerance before webhook signature is considered invalid
WEBHOOK_TIMESTAMP_TOLERANCE=

# Webhook encoding algorithm, defaults to sha256
WEBHOOK_ENCODE_ALG=

# Webhook digestion method, defaults to base64
WEBHOOK_DIGEST_METHOD=

# The server port, defaults to 3000
WEBHOOK_SERVER_PORT=

# Port for the single-port server (npm run serve / start), defaults to 4040.
# Ignored under docker-compose.server.yml, which fixes the container's port and
# remaps it on the host via APP_HOST_PORT instead.
#PORT=


# Server deployment only
#
# docker-compose.server.yml reads this same file for its own ${...}
# substitutions, so the database's credentials belong in APP_ENV alongside the
# application's. POSTGRES_PASSWORD has no default and the deploy fails without
# it; the other two default to "nimbrosa".
#
# These take effect when the volume is first created and are ignored on every
# start after that. Changing them later does not change the existing database —
# it just makes DATABASE_URL wrong. Keep the two in sync.
#POSTGRES_USER=nimbrosa
#POSTGRES_PASSWORD=
#POSTGRES_DB=nimbrosa

# Host ports for the server stack. Defaults sidestep what is already bound on
# that box: 4040 for the app, 5433 for postgres, 8087 for embeddings.
#APP_HOST_PORT=4040
#POSTGRES_HOST_PORT=5433
#EMBEDDINGS_HOST_PORT=8087
